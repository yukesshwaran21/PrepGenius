// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  resumes   Resume[]
  interviews Interview[]
  codingSubmissions CodingSubmission[]

  @@map("users")
}

model Resume {
  id              Int     @id @default(autoincrement())
  userId          Int
  fileUrl         String
  analysisResult  Json?   // Store AI analysis as JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model Interview {
  id          Int     @id @default(autoincrement())
  userId      Int
  role        String  // e.g., "Java Developer", "React Developer"
  difficulty  String  // e.g., "beginner", "intermediate", "advanced"
  requestedDifficulty String? // Original user-selected difficulty
  mode        String  @default("standard")
  totalTimeLimitSec Int?
  setIndex    Int     @default(1)
  setCount    Int     @default(3)
  shuffleEnabled Boolean @default(true)
  adaptiveEnabled Boolean @default(true)
  questionTimeLimitSec Int @default(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   Question[]

  @@map("interviews")
}

model Question {
  id          Int     @id @default(autoincrement())
  interviewId Int
  questionText String
  options     Json?
  correctOptionId String?
  explanation String?
  difficultyTag String?
  isFollowUp Boolean @default(false)
  parentQuestionId Int?
  createdAt   DateTime @default(now())

  // Relations
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  parentQuestion Question? @relation("QuestionFollowUps", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  followUps   Question[] @relation("QuestionFollowUps")
  answers     Answer[]

  @@map("questions")
}

model Answer {
  id          Int     @id @default(autoincrement())
  questionId  Int
  userAnswer  String
  aiFeedback  String?
  score       Int?    // 0-1 mark
  adaptiveScore Float?
  scoreBreakdown Json?
  streakCount Int? @default(0)
  answerStartedAt DateTime?
  answerSubmittedAt DateTime?
  timeSpentSeconds Int?
  timedOut    Boolean @default(false)
  autoSubmitted Boolean @default(false)
  createdAt   DateTime @default(now())

  // Relations
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model CodingProblem {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  difficulty  String
  description String
  timeLimitMs Int      @default(2000)
  memoryLimitMb Int    @default(256)
  supportedLanguages Json
  starterCode Json
  referenceSolutions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases   CodingTestCase[]
  submissions CodingSubmission[]

  @@map("coding_problems")
}

model CodingTestCase {
  id          Int      @id @default(autoincrement())
  problemId   Int
  input       String
  expectedOutput String
  isHidden    Boolean  @default(false)
  weight      Int      @default(1)
  createdAt   DateTime @default(now())

  problem     CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("coding_test_cases")
}

model CodingSubmission {
  id          Int      @id @default(autoincrement())
  userId      Int
  problemId   Int
  language    String
  sourceCode  String
  status      String
  runtimeMs   Int?
  memoryMb    Int?
  totalTests  Int
  passedTests Int
  score       Float
  similarityScore Float?
  complexityEstimate String?
  executionLog Json?
  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem     CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("coding_submissions")
}
